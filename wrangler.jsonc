{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 관리자 Worker (admin.taerim.page). 공개 사이트와는 별도
  "name": "taerim-page-admin",
  "main": "src/worker/admin.ts",
  "compatibility_date": "2026-11-01",

  // 주소: admin.taerim.page (Cloudflare가 DNS·인증서를 알아서 만든다)
  // *.workers.dev·미리보기 주소는 끈다 → 관리자 화면은 Access가 걸린 admin.taerim.page로만
  "routes": [{ "pattern": "admin.taerim.page", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  // 배포용 설정값 (비밀 아님). 비어 있으면 관리자 확인이 "모두 막음"이 된다 (설정을 잊어도 열리지 않게)
  // - ACCESS_TEAM_DOMAIN: Zero Trust > Settings > Team domain / ACCESS_AUD: Access 앱(admin.taerim.page) > Additional settings > AUD tag
  // - ADMIN_EMAILS: 들어올 수 있는 이메일 (쉼표로 여러 개)
  // 비밀값 GITHUB_DEPLOY_TOKEN은 여기 넣지 않고 `npx wrangler secret put GITHUB_DEPLOY_TOKEN`으로
  "vars": {
    "ACCESS_TEAM_DOMAIN": "taerim0.cloudflareaccess.com",
    "ACCESS_AUD": "b157487e544c9860603839ed8ce37cf0d6f3bb9056a05ed367da28fc9a23bde8",
    "ADMIN_EMAILS": "taerim.be@gmail.com",
    "GITHUB_REPOSITORY": "taerim0/taerim.page"
  },
  // 주의: ENVIRONMENT 같은 개발용 값은 여기 넣지 않는다 (배포에도 적용되므로).
  // 로컬 개발용 값은 .dev.vars 에만 둔다.

  // wrangler dev·deploy 전에 관리자 화면용 번들을 만든다 (admin-ui/assets/lib.js: 렌더러·태그 정리·글자 수)
  // src 를 고치면 wrangler dev 가 다시 묶는다
  "build": {
    // wrangler는 레포 폴더(repository/taerim.page)에서 실행한다 (npx wrangler dev)
    "command": "npm run build:admin",
    "watch_dir": "src"
  },

  "d1_databases": [
    {
      // 코드에서 env.DB 로 쓴다
      "binding": "DB",
      "database_name": "taerim-page-db",
      // 2026-11-07 생성 (위치: APAC). 비밀값이 아니라 커밋해도 됨
      "database_id": "790dc115-59f4-4a28-a219-55138e4d816e",
      "migrations_dir": "migrations"
    }
  ],

  // 관리자 화면 파일 (admin-ui 폴더). 코드에서 env.ASSETS 로 꺼낸다
  "assets": {
    "directory": "admin-ui",
    "binding": "ASSETS",
    // 모든 요청이 먼저 Worker를 거치게 한다 → 화면 파일도 관리자 확인 뒤에만 나감
    "run_worker_first": true,
    // 주소를 자동으로 바꾸지 않는다 (/post.html → /post 같은 자동 이동 없이 파일 이름 그대로)
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
